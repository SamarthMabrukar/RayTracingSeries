// ShaderChecker.idl - REQUIRES oaidl.idl for Automation
// Enhanced interface with diagnostic properties
import "oaidl.idl";

[
    object,
    uuid(AAC09469-23D7-4B8E-B454-776CA3B19AD2),
    helpstring("IShaderChecker Interface"),
    pointer_default(unique),
    dual,
    oleautomation
]
interface IShaderChecker : IDispatch
{
    // Primary check - returns TRUE if SM 6.9 is supported
    [id(1), propget] HRESULT IsSupported([out,retval] VARIANT_BOOL* pVal);
    
    // ENHANCEMENT: Get the highest shader model supported (e.g., "6.9", "6.8", "6.6")
    [id(2), propget] HRESULT HighestShaderModel([out,retval] BSTR* pVal);
    
    // ENHANCEMENT: Get the GPU adapter name
    [id(3), propget] HRESULT AdapterName([out,retval] BSTR* pVal);
    
    // ENHANCEMENT: Get the feature level (e.g., "12_2", "12_1", "12_0")
    [id(4), propget] HRESULT FeatureLevel([out,retval] BSTR* pVal);
    
    // ENHANCEMENT: Get last error/status message for diagnostics
    [id(5), propget] HRESULT LastError([out,retval] BSTR* pVal);
    
    // ENHANCEMENT: Check if experimental features are enabled
    [id(6), propget] HRESULT ExperimentalFeaturesEnabled([out,retval] VARIANT_BOOL* pVal);
};

[
    uuid(65C6A5B5-B00F-4ECE-8262-B993B4B80542),
    version(1.0),
    helpstring("ShaderChecker component's type library")
]
library ShaderCheckerTypeLib
{
    importlib("stdole32.tlb");
    [
        uuid(54F71999-647C-4B98-BFF9-84F28A9A25E5),
        helpstring("ShaderChecker Automation Component Class")
    ]
    coclass CShaderChecker
    {
        [default] interface IShaderChecker;
    };
};
